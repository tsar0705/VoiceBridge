# ==============================================================================
# VoiceBridge Backend Production Environment Variables
# ==============================================================================
# IMPORTANT: In production, configure these via your hosting platform's
# environment dashboard (e.g., Render, Railway, AWS ECS). Never commit actual keys.

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
# Comma-separated list of allowed frontend origins (e.g. your Vercel deployment URL)
CORS_ORIGINS=https://voicebridge.vercel.app,https://your-custom-domain.com

# Gnani AI Prisma STT Configuration
GNANI_API_KEY=your_gnani_api_key_here
GNANI_PRISMA_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_PRISMA_MODEL=prisma-v3.0

# Gnani AI Timbre TTS Configuration
GNANI_TIMBRE_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_TIMBRE_MODEL=timbre-v2.5
GNANI_DEFAULT_VOICE=Nalini

# LLM Reasoning Configuration (Modular: gemini | openai | gnani_evon)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
OPENAI_BASE_URL=https://api.openai.com/v1
MAX_HISTORY_TURNS=10

# Audio Processing Constraints
MAX_AUDIO_SIZE_MB=10
MAX_RECORDING_DURATION_SEC=30
