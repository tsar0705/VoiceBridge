# VoiceBridge Backend Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Gnani AI Credentials & Endpoints
# Passed in requests as X-API-Key-ID header
GNANI_API_KEY=your_gnani_api_key_here
GNANI_PRISMA_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_PRISMA_MODEL=prisma-v3.0

GNANI_TIMBRE_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_TIMBRE_MODEL=timbre-v2.5
GNANI_DEFAULT_VOICE=Nalini

# LLM Reasoning Engine (Modular provider: gemini | openai | gnani_evon | anthropic)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-flash

# Audio constraints (Max 30s per Gnani API spec)
MAX_AUDIO_SIZE_MB=10
MAX_RECORDING_DURATION_SEC=30
